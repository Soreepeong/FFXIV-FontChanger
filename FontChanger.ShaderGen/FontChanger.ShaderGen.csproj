<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FontChanger.ShaderGen</RootNamespace>
    <Description>Build tool: completes FontChanger.DalamudPlugin's FontEdgePS.hlsl with generated code and compiles it to bytecode (D3DCompile).</Description>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Runs on the build machine, which is Windows (d3dcompiler_47.dll is part of Windows 10 and later). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- The solution builds it as x64; the output stays in bin\$(Configuration). -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's patching of the shaders' settings, checked against the compiler on every build. -->
    <Compile Include="..\FontChanger.DalamudPlugin\Fonts\Shaders\ShaderCode.cs" Link="ShaderCode.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="obj\Debug\net10.0\apphost.exe" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.csproj.CoreCompileInputs.cache" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.csproj.FileListAbsolute.txt" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.dll" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.genruntimeconfig.cache" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.pdb" />
    <Content Include="obj\Debug\net10.0\FontChanger.ShaderGen.sourcelink.json" />
    <Content Include="obj\rider.project.model.nuget.info" />
  </ItemGroup>
</Project>
