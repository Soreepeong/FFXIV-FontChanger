<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Version>0.0.0.1</Version>
		<RootNamespace>FontChanger.DalamudPlugin</RootNamespace>
		<Description>Provides expanded choices of fonts.</Description>
		<IsPackable>false</IsPackable>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
		<CompileShaders Condition="'$(CompileShaders)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</CompileShaders>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
			<_Parameter1>windows10.0.19043.0</_Parameter1>
		</AssemblyAttribute>
		<ProjectReference Include="..\FontChanger.Presets\FontChanger.Presets.csproj"/>
		<Using Include="FontChanger.Presets"/>
		<PackageReference Include="FreeTypeSharp" Version="3.1.0"/>
		<Reference Include="TerraFX.Interop.Windows" Private="false"/>
		<Reference Include="JetBrains.Annotations" Private="false"/>
	</ItemGroup>
	<ItemGroup Label="Unicode Character Database files, which UnicodeData's tables are generated from">
		<ProjectReference Include="..\FontChanger.UnicodeDataGenerator\FontChanger.UnicodeDataGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained"/>
		<AdditionalFiles Include="Utilities\Unicode\*.txt"/>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Fonts\Shaders\*.cso" />
	</ItemGroup>
	<ItemGroup Condition="'$(CompileShaders)' == 'true'">
		<ProjectReference Include="..\FontChanger.ShaderGen\FontChanger.ShaderGen.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained"/>
	</ItemGroup>
	<Target Name="ResolveShaderGen" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true' And '$(CompileShaders)' == 'true'">
		<MSBuild Projects="..\FontChanger.ShaderGen\FontChanger.ShaderGen.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
			<Output TaskParameter="TargetOutputs" PropertyName="ShaderGenPath"/>
		</MSBuild>
	</Target>
	<Target Name="CompileEdgeShader" DependsOnTargets="ResolveShaderGen" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' And '$(CompileShaders)' == 'true'" Inputs="Fonts\Shaders\FontEdgePS.hlsl;Fonts\Shaders\FontEdgeSquares.hlsli;$(ShaderGenPath)" Outputs="$(IntermediateOutputPath)FontEdgePS.cso;Fonts\Shaders\FontEdgePS.cso">
		<Exec Command="&quot;$([System.IO.Path]::ChangeExtension('$(ShaderGenPath)', '.exe'))&quot; &quot;Fonts\Shaders\FontEdgePS.hlsl&quot; &quot;$(IntermediateOutputPath)FontEdgePS.cso&quot;"/>
		<Copy SourceFiles="$(IntermediateOutputPath)FontEdgePS.cso" DestinationFolder="Fonts\Shaders"/>
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)FontEdgePS.cso;$(IntermediateOutputPath)FontEdgePS.hlsl;$(IntermediateOutputPath)FontEdgePS.asm"/>
		</ItemGroup>
	</Target>
	<Target Name="CompileSubpixelShaders" DependsOnTargets="ResolveShaderGen" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' And '$(CompileShaders)' == 'true'" Inputs="Fonts\Shaders\FontSubpixelPS.hlsl;$(ShaderGenPath)" Outputs="$(IntermediateOutputPath)FontSubpixelPS.cso;$(IntermediateOutputPath)FontSubpixelHighlightPS.cso;Fonts\Shaders\FontSubpixelPS.cso;Fonts\Shaders\FontSubpixelHighlightPS.cso">
		<Exec Command="&quot;$([System.IO.Path]::ChangeExtension('$(ShaderGenPath)', '.exe'))&quot; --subpixel &quot;Fonts\Shaders\FontSubpixelPS.hlsl&quot; &quot;$(IntermediateOutputPath)FontSubpixelPS.cso&quot;"/>
		<Exec Command="&quot;$([System.IO.Path]::ChangeExtension('$(ShaderGenPath)', '.exe'))&quot; --subpixel &quot;Fonts\Shaders\FontSubpixelPS.hlsl&quot; &quot;$(IntermediateOutputPath)FontSubpixelHighlightPS.cso&quot; --highlight"/>
		<Copy SourceFiles="$(IntermediateOutputPath)FontSubpixelPS.cso;$(IntermediateOutputPath)FontSubpixelHighlightPS.cso" DestinationFolder="Fonts\Shaders"/>
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)FontSubpixelPS.cso;$(IntermediateOutputPath)FontSubpixelPS.asm;$(IntermediateOutputPath)FontSubpixelHighlightPS.cso;$(IntermediateOutputPath)FontSubpixelHighlightPS.asm"/>
		</ItemGroup>
	</Target>
</Project>
