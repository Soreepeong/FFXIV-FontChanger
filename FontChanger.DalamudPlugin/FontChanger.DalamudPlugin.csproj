<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <RootNamespace>CustomFonts</RootNamespace>
    <Description>Renders the game's UI text with DirectWrite glyphs rasterized on demand, instead of the prebaked font atlases.</Description>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Dalamud runs on Windows 10 and later; APIs of later versions are checked for where they are used. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\xivres\data\game_font_signatures.json" LogicalName="CustomFonts.game_font_signatures.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FontChanger.Presets\FontChanger.Presets.csproj" />
    <Using Include="FontChanger.Presets" />
  </ItemGroup>
  <ItemGroup>
    <!-- FreeType, with its native library; for elements a preset draws with FreeType, and bitmap-only fonts. -->
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The game is always an x64 Windows process: under WINE, and under x64 emulation on Windows on Arm. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- The solution builds it as x64; the output stays in bin\$(Configuration), where Dalamud loads it from. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- DirectWrite and D3D11; Dalamud ships and loads it. -->
    <Reference Include="TerraFX.Interop.Windows" Private="false" />
  </ItemGroup>

  <!-- The edge shader (Rendering\FontEdgePS.hlsl) is completed and compiled by FontChanger.ShaderGen at build time; the
       bytecode is embedded. The tool is only built first, not referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\FontChanger.ShaderGen\FontChanger.ShaderGen.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <Target Name="ResolveShaderGen" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\FontChanger.ShaderGen\FontChanger.ShaderGen.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="ShaderGenPath" />
    </MSBuild>
  </Target>
  <Target Name="CompileEdgeShader" DependsOnTargets="ResolveShaderGen" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="Rendering\FontEdgePS.hlsl;$(ShaderGenPath)" Outputs="$(IntermediateOutputPath)FontEdgePS.cso">
    <Exec Command="&quot;$([System.IO.Path]::ChangeExtension('$(ShaderGenPath)', '.exe'))&quot; &quot;Rendering\FontEdgePS.hlsl&quot; &quot;$(IntermediateOutputPath)FontEdgePS.cso&quot;" />
  </Target>
  <Target Name="EmbedEdgeShader" AfterTargets="CompileEdgeShader" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)FontEdgePS.cso" LogicalName="CustomFonts.Rendering.FontEdgePS.cso" />
      <FileWrites Include="$(IntermediateOutputPath)FontEdgePS.cso;$(IntermediateOutputPath)FontEdgePS.hlsl;$(IntermediateOutputPath)FontEdgePS.asm" />
    </ItemGroup>
  </Target>
</Project>
